---
# /letters.json: a machine-readable index of every letter, newest first (the same
# order as the home page). Built from the letters' front matter on every build;
# no page uses it yet, it is the data source for future themes.
# url, cover and bgm are percent-encoded, site-relative URLs.
---
[
{%- for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "date": {{ post.date | date_to_xmlschema | jsonify }},
    "url": {{ post.url | jsonify }},
    "author": {{ post.author | default: site.author.name | jsonify }},
    "cover": {% if post.image.feature %}{{ post.image.feature | prepend: site.baseurl_featured_img | uri_escape | jsonify }}{% else %}null{% endif %},
    "bgm": {% if post.bgm %}{{ post.bgm | prepend: "/assets/bgm/" | uri_escape | jsonify }}{% else %}null{% endif %},
    "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | strip | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
